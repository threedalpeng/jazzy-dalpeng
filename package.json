{
	"name": "jazz",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && node scripts/prepare-pages.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"format:check": "prettier --check .",
		"validate": "npm run check && npm run lint && npm run format:check && npm test && npm run build",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"idb": "^8.0.3",
		"mini-svg-data-uri": "^1.4.4",
		"smplr": "^1.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/heroicons": "^1.2.3",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.1",
		"@vite-pwa/assets-generator": "^2.0.0",
		"autoprefixer": "^10.6.1",
		"daisyui": "^4.12.24",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass": "^1.105.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"imports": {
		"#src/*": "./src/*",
		"#lib/*": "./src/lib/*",
		"#assets/*": "./src/assets/*",
		"#canvas": "./src/lib/canvas/index.ts",
		"#canvas/*": "./src/lib/canvas/*"
	}
}
