{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": ["node", "svelte", "vite/client", "$app/types"]
	},
	"include": ["src", "test", "*"]
}
